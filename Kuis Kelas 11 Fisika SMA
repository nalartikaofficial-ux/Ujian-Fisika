    function determinePacket(absenNum) {
      const packets = ["Paket A", "Paket B", "Paket C", "Paket D", "Paket E"];
      const num = parseInt(absenNum) || 1;
      return packets[(num - 1) % 5];
    }

    function startExam() {
      const name = document.getElementById('student-name').value.trim();
      const studentClass = document.getElementById('student-class').value;
      const nis = document.getElementById('student-nis').value.trim();
      const token = document.getElementById('exam-token').value.trim().toUpperCase();

      if (!name || !nis) {
        alert("Silakan lengkapi Nama Siswa dan Nomor Absen!");
        return;
      }
      if (token !== VALID_TOKEN) {
        alert("Token Ujian Salah! Masukkan token resmi: VEKTOR11");
        return;
      }

      const completedList = JSON.parse(localStorage.getItem('cbt_completed_submissions_xi_hots') || '[]');
      const isAlreadySubmitted = completedList.some(item => item.name.toLowerCase() === name.toLowerCase() && item.nis === nis);
      if (isAlreadySubmitted) {
        alert("Nama dan Nomor Absen ini telah tercatat mengirimkan ujian sebelumnya!");
        showBlockedScreen({ name, class: studentClass, nis, packet: determinePacket(nis) });
        return;
      }

      selectedPacketName = determinePacket(nis);
      questions = questionPackets[selectedPacketName];
      studentData = { name, class: studentClass, nis, packet: selectedPacketName };
      saveToLocalStorage();
      launchExamUI();
    }

    function launchExamUI() {
      document.getElementById('step-identity').classList.add('hidden');
      document.getElementById('step-exam').classList.remove('hidden');
