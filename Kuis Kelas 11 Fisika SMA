    function calcInput(ch) {
      if (ch === 'rad/deg') {
        isDeg = !isDeg;
        document.getElementById('calc-angle-btn').textContent = isDeg ? "DEG" : "RAD";
        return;
      }
      if (document.getElementById('calc-display').value === "0" && ch !== ".") {
        calcExpr = ch;
      } else {
        calcExpr += ch;
      }
      updateCalcDisplay(calcExpr);
    }

    function calcOp(op) {
      if (calcExpr === "" && op === '-') {
        calcExpr = "-";
      } else {
        calcExpr += ` ${op} `;
      }
      updateCalcDisplay(calcExpr);
    }

    function calcClear() {
      calcExpr = "";
      updateCalcDisplay("0");
    }

    function calcBackspace() {
      calcExpr = calcExpr.trimEnd();
      calcExpr = calcExpr.slice(0, -1).trimEnd();
      updateCalcDisplay(calcExpr || "0");
    }

    function calcConst(c) {
      if (c === 'pi') calcExpr += Math.PI.toFixed(6);
      if (c === 'e') calcExpr += Math.E.toFixed(6);
      updateCalcDisplay(calcExpr);
    }

    function calcFunc(fn) {
      try {
        let current = evalSafe(calcExpr || document.getElementById('calc-display').value);
        let res = 0;
        if (fn === 'sin') res = isDeg ? Math.sin(current * Math.PI / 180) : Math.sin(current);
        if (fn === 'cos') res = isDeg ? Math.cos(current * Math.PI / 180) : Math.cos(current);
        if (fn === 'tan') res = isDeg ? Math.tan(current * Math.PI / 180) : Math.tan(current);
        if (fn === 'ln') res = Math.log(current);
        if (fn === 'log') res = Math.log10(current);
        if (fn === 'sqrt') res = Math.sqrt(current);
        if (fn === 'sqr') res = Math.pow(current, 2);
        if (fn === 'inv') res = 1 / current;
        if (fn === '10pow') res = Math.pow(10, current);
        if (fn === 'pm') res = -current;
        if (fn === 'exp') { calcExpr += "*10^"; updateCalcDisplay(calcExpr); return; }

        calcExpr = String(Number(res.toFixed(8)));
        updateCalcDisplay(calcExpr);
      } catch (e) {
        updateCalcDisplay("Error");
        calcExpr = "";
      }
    }

    function evalSafe(expr) {
      if (!expr) return 0;
      let sanitized = expr.replace(/\^/g, '**').replace(/×/g, '*').replace(/÷/g, '/');
      return Function(`'use strict'; return (${sanitized})`)();
    }

    function calcEquals() {
      try {
        let result = evalSafe(calcExpr);
        if (isNaN(result) || !isFinite(result)) throw new Error();
        calcExpr = String(Number(result.toFixed(8)));
        updateCalcDisplay(calcExpr);
      } catch (e) {
        updateCalcDisplay("Error");
        calcExpr = "";
      }
    }
  </script>
</body>
