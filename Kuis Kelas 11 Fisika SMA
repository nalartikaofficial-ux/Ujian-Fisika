    async function sendDataToGoogleScript() {
      if (!GOOGLE_SCRIPT_WEBAPP_URL || GOOGLE_SCRIPT_WEBAPP_URL.includes("URL_GOOGLE_APPS_SCRIPT")) return;

      const payload = {
        nama: studentData.name,
        kelas: studentData.class,
        absen: studentData.nis,
        paket: selectedPacketName,
        pelanggaranTab: tabSwitchCount,
        waktu: new Date().toISOString(),
        jawabanTeks: textDataStore,
        jawabanGambar: canvasDataStore
      };

      try {
        await fetch(GOOGLE_SCRIPT_WEBAPP_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (e) {
        console.error(e);
      }
    }

