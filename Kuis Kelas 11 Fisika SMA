      if (tabSwitchCount > 0) {
        document.getElementById('cheat-badge').classList.remove('hidden');
        document.getElementById('cheat-badge').classList.add('flex');
        document.getElementById('cheat-count-display').textContent = tabSwitchCount;
      }

      renderPills();
      loadQuestion(currentIdx);
      startTimer();
      window.addEventListener('resize', handleCanvasResize);
      setTimeout(handleCanvasResize, 100);
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      const display = document.getElementById('timer-display');
      timerInterval = setInterval(() => {
        timerSeconds--;
        const m = Math.floor(timerSeconds / 60);
        const s = timerSeconds % 60;
        display.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        
        if (timerSeconds % 10 === 0) saveToLocalStorage();

        if (timerSeconds <= 0) {
          clearInterval(timerInterval);
          alert("Waktu pengerjaan 60 menit telah habis! Lembar pengerjaan Anda otomatis dikirim.");
          finishExam();
        }
      }, 1000);
    }

    function handleCanvasResize() {
      const rect = canvas.getBoundingClientRect();
      const currentData = canvasDataStore[currentIdx];
      canvas.width = rect.width * (window.devicePixelRatio || 1);
      canvas.height = rect.height * (window.devicePixelRatio || 1);
      ctx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);
      
      drawCanvasBackground();

      if (currentData) {
        const img = new Image();
        img.src = currentData;
        img.onload = () => ctx.drawImage(img, 0, 0, rect.width, rect.height);
      }
    }

    function drawCanvasBackground() {
      const rect = canvas.getBoundingClientRect();
      ctx.save();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, rect.width, rect.height);
      ctx.restore();
    }

    function getCoords(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: clientX - rect.left, y: clientY - rect.top };
    }

    function startDraw(e) {
      e.preventDefault();
      isDrawing = true;
      const pos = getCoords(e);
      ctx.beginPath();
      ctx.moveTo(pos.x, pos.y);
    }

    function draw(e) {
      if (!isDrawing) return;
      e.preventDefault();
      const pos = getCoords(e);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      if (currentTool === 'eraser') {
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 24;
      } else {
        ctx.strokeStyle = currentColor;
        ctx.lineWidth = lineWidth;
      }
      ctx.lineTo(pos.x, pos.y);
      ctx.stroke();
    }

    function stopDraw(e) {
      if (!isDrawing) return;
      isDrawing = false;
      ctx.closePath();
      saveCurrentQuestionState();
    }

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDraw);
    canvas.addEventListener('mouseleave', stopDraw);

    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    canvas.addEventListener('touchend', stopDraw);

    function setTool(tool) {
      currentTool = tool;
      document.getElementById('tool-pen').className = tool === 'pen' ? 'px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold text-xs' : 'px-3 py-1.5 rounded-lg bg-slate-300 text-slate-800 font-bold text-xs';
      document.getElementById('tool-eraser').className = tool === 'eraser' ? 'px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold text-xs' : 'px-3 py-1.5 rounded-lg bg-slate-300 text-slate-800 font-bold text-xs';
    }

    function setColor(color) {
      currentColor = color;
      setTool('pen');
    }

    function clearCurrentCanvas() {
      if (confirm(`Hapus coretan langkah pengerjaan Nomor ${currentIdx + 1}?`)) {
        drawCanvasBackground();
        delete canvasDataStore[currentIdx];
        saveToLocalStorage();
        updatePills();
      }
    }

    function saveCurrentQuestionState() {
      canvasDataStore[currentIdx] = canvas.toDataURL("image/png");
      textDataStore[currentIdx] = document.getElementById('final-answer-input').value;
      saveToLocalStorage();
      updatePills();
    }

    function renderPills() {
      const container = document.getElementById('soal-pills');
      container.innerHTML = "";
      questions.forEach((_, idx) => {
        const btn = document.createElement('button');
        btn.id = `pill-${idx}`;
        btn.textContent = idx + 1;
        btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition ${idx === currentIdx ? 'bg-indigo-600 text-white' : 'bg-slate-300 text-slate-700'}`;
        btn.onclick = () => {
          saveCurrentQuestionState();
          loadQuestion(idx);
        };
        container.appendChild(btn);
      });
    }

    function updatePills() {
      questions.forEach((_, idx) => {
        const pill = document.getElementById(`pill-${idx}`);
        if (!pill) return;
        const hasWork = canvasDataStore[idx] || (textDataStore[idx] && textDataStore[idx].trim() !== "");
        if (idx === currentIdx) {
          pill.className = "w-8 h-8 rounded-lg text-xs font-bold bg-indigo-600 text-white shadow";
        } else if (hasWork) {
          pill.className = "w-8 h-8 rounded-lg text-xs font-bold bg-emerald-600 text-white";
        } else {
          pill.className = "w-8 h-8 rounded-lg text-xs font-bold bg-slate-300 text-slate-700";
        }
      });
    }

    function loadQuestion(idx) {
      currentIdx = idx;
      const q = questions[idx];
      document.getElementById('soal-badge').textContent = `Soal ${idx + 1} dari ${questions.length} (${selectedPacketName})`;
      document.getElementById('materi-badge').textContent = `Topik: ${q.topic}`;
      document.getElementById('question-text').textContent = q.text;

      document.getElementById('btn-prev').disabled = (idx === 0);
      document.getElementById('btn-next').textContent = (idx === questions.length - 1) ? 'Papan Terakhir' : 'Berikutnya ➡';

      document.getElementById('final-answer-input').value = textDataStore[idx] || "";

      drawCanvasBackground();

      if (canvasDataStore[idx]) {
        const img = new Image();
        img.src = canvasDataStore[idx];
        img.onload = () => ctx.drawImage(img, 0, 0, canvas.getBoundingClientRect().width, canvas.getBoundingClientRect().height);
      }
      updatePills();
    }

    function prevQuestion() {
      if (currentIdx > 0) {
        saveCurrentQuestionState();
        loadQuestion(currentIdx - 1);
      }
    }

    function nextQuestion() {
      if (currentIdx < questions.length - 1) {
        saveCurrentQuestionState();
        loadQuestion(currentIdx + 1);
      }
    }

    function finishExamPrompt() {
      saveCurrentQuestionState();
      if (confirm("Apakah Anda yakin ingin menyelesaikan dan mengirim seluruh lembar ujian sekarang? Setelah dikirim, Anda tidak dapat mengakses ujian ini lagi.")) {
        finishExam();
      }
    }

