<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Asesmen Fisika XI - Vektor HOTS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; touch-action: manipulation; }
    .canvas-container { touch-action: none; }
  </style>
</head>
<body class="bg-slate-200 text-slate-900 min-h-screen flex flex-col justify-between select-none">

  <!-- HEADER -->
  <header class="bg-slate-800 text-white border-b border-slate-700 sticky top-0 z-40 px-4 py-3 shadow-md">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow">
          🧭
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold leading-tight">Asesmen Analisis Vektor XI</h1>
          <p class="text-xs text-slate-300">Pengampu: Fadhillah Umar, S.Pd. • <span id="header-packet" class="font-bold text-amber-300">Kelas XI-1</span></p>
        </div>
      </div>

      <!-- TIMER & CHEAT BADGE -->
      <div class="flex items-center space-x-2">
        <div id="cheat-badge" class="hidden items-center bg-rose-900/80 border border-rose-500 px-2.5 py-1 rounded-lg text-xs text-rose-200 font-bold animate-pulse">
          ⚠️ Peringatan Tab: <span id="cheat-count-display" class="ml-1 text-white">0</span>/3
        </div>
        <div id="timer-box" class="hidden items-center space-x-2 bg-slate-900 px-3.5 py-1.5 rounded-xl border border-slate-700">
          <span class="text-amber-400">⏱️</span>
          <span id="timer-display" class="font-mono text-sm sm:text-base font-bold text-amber-300">60:00</span>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-6xl mx-auto w-full p-3 sm:p-4 flex-1 flex flex-col justify-center">

    <!-- STEP 1: LOGIN IDENTITAS & TOKEN -->
    <section id="step-identity" class="max-w-md mx-auto w-full bg-slate-100 p-6 sm:p-8 rounded-3xl border-2 border-slate-300 shadow-xl my-auto">
      <div class="text-center mb-6">
        <span class="px-3 py-1 bg-indigo-100 text-indigo-800 text-xs font-bold rounded-full border border-indigo-200">Asesmen Analisis HOTS (5 Paket Setara)</span>
        <h2 class="text-2xl font-black mt-3 text-slate-900">Identitas Siswa</h2>
        <p class="text-slate-600 text-xs mt-1">Gunakan papan coret dan kalkulator sains terintegrasi untuk menganalisis soal.</p>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-800 mb-1.5">Nama Lengkap Siswa</label>
          <input type="text" id="student-name" placeholder="Nama lengkap sesuai absensi" class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-300 text-sm font-semibold focus:outline-none focus:border-indigo-600 text-slate-900 transition">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-800 mb-1.5">Kelas</label>
            <select id="student-class" class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-300 text-sm font-semibold focus:outline-none focus:border-indigo-600 text-slate-900 transition">
              <option value="XI-1">XI-1</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-800 mb-1.5">Nomor Absen</label>
            <input type="number" id="student-nis" placeholder="Nomor Absen (1-36)" class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-300 text-sm font-semibold focus:outline-none focus:border-indigo-600 text-slate-900 transition">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-800 mb-1.5">Token Ujian</label>
          <input type="text" id="exam-token" placeholder="Masukkan TOKEN (cth: VEKTOR11)" class="w-full px-4 py-2.5 rounded-xl bg-white border border-slate-300 text-sm font-mono uppercase font-bold focus:outline-none focus:border-indigo-600 text-slate-900 transition">
        </div>

        <div class="pt-2">
          <button onclick="startExam()" class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 font-bold text-sm rounded-xl shadow-lg transition active:scale-95 text-white flex items-center justify-center space-x-2">
            <span>Masuk & Kerjakan Ujian</span>
            <span>➔</span>
          </button>
        </div>
      </div>
    </section>

    <!-- STEP 2: INTERFACE UJIAN & WHITEBOARD POLOS -->
    <section id="step-exam" class="hidden flex-col lg:flex-row gap-5 my-auto">
      
      <!-- KIRI: SOAL & INPUT HASIL AKHIR -->
      <div class="lg:w-5/12 flex flex-col justify-between bg-slate-100 p-5 rounded-3xl border-2 border-slate-300 shadow-md space-y-4">
        <div>
          <div class="flex items-center justify-between border-b border-slate-300 pb-3 mb-3">
            <span id="soal-badge" class="px-3 py-1 bg-indigo-600 text-white text-xs font-bold rounded-lg shadow-sm">Soal 1 dari 5</span>
            <span id="materi-badge" class="text-xs text-amber-900 bg-amber-100 px-2.5 py-1 rounded-md font-bold border border-amber-300">Topik: Analisis Vektor</span>
          </div>

          <div class="min-h-[160px] bg-white p-4 rounded-2xl border border-slate-300 shadow-sm">
            <p id="question-text" class="text-sm font-semibold text-slate-900 leading-relaxed"></p>
          </div>

          <div class="mt-4">
            <label class="block text-xs font-bold text-slate-800 mb-1.5">Hasil Akhir Perhitungan (Wajib Diisi):</label>
            <input type="text" id="final-answer-input" oninput="saveCurrentQuestionState()" placeholder="Tulis jawaban akhir lengkap dengan satuan" class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-xs sm:text-sm font-bold focus:outline-none focus:border-indigo-600 text-slate-900">
          </div>
        </div>

        <!-- NAVIGASI NOMOR -->
        <div class="pt-3 border-t border-slate-300 flex items-center justify-between gap-2">
          <button id="btn-prev" onclick="prevQuestion()" class="px-3.5 py-2 rounded-xl bg-slate-300 hover:bg-slate-400 text-xs font-bold transition disabled:opacity-40 disabled:cursor-not-allowed text-slate-800">
            ⬅ Sebelumnya
          </button>
          
          <div class="flex gap-1.5 overflow-x-auto" id="soal-pills"></div>

          <button id="btn-next" onclick="nextQuestion()" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-xs font-bold transition text-white">
            Berikutnya ➡
          </button>
        </div>
      </div>

      <!-- KANAN: PAPAN CORET SKETSA & RUMUS -->
      <div class="lg:w-7/12 bg-slate-100 p-4 sm:p-5 rounded-3xl border-2 border-slate-300 shadow-md flex flex-col">
        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-300 text-xs">
          <div class="flex items-center space-x-2">
            <span class="font-bold text-slate-900">✍️ Sketsa & Langkah Pengerjaan</span>
            <span class="text-[11px] text-slate-600 hidden sm:inline">(Tersimpan per nomor)</span>
          </div>

          <!-- TOOLBAR WHITEBOARD -->
          <div class="flex items-center space-x-1.5 sm:space-x-2">
            <button onclick="toggleCalculator()" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold text-xs shadow-sm flex items-center space-x-1">
              <span>🧮</span>
              <span>Kalkulator</span>
            </button>
            <button onclick="setTool('pen')" id="tool-pen" class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold text-xs">Pena</button>
            <button onclick="setTool('eraser')" id="tool-eraser" class="px-3 py-1.5 rounded-lg bg-slate-300 text-slate-800 font-bold text-xs">Penghapus</button>
            
            <div class="flex items-center space-x-1.5 bg-white px-2 py-1 rounded-lg border border-slate-300">
              <button onclick="setColor('#0f172a')" class="w-4 h-4 rounded-full bg-slate-900 border border-slate-400" title="Hitam"></button>
              <button onclick="setColor('#1d4ed8')" class="w-4 h-4 rounded-full bg-blue-700" title="Biru"></button>
              <button onclick="setColor('#b91c1c')" class="w-4 h-4 rounded-full bg-red-700" title="Merah"></button>
            </div>

            <button onclick="clearCurrentCanvas()" class="px-2.5 py-1.5 rounded-lg bg-rose-100 border border-rose-300 text-rose-800 hover:bg-rose-200 font-bold text-xs">Reset</button>
          </div>
        </div>

        <!-- CANVAS WHITEBOARD AREA -->
        <div class="relative w-full flex-1 bg-white rounded-2xl border-2 border-slate-300 overflow-hidden canvas-container min-h-[380px] flex items-center justify-center shadow-inner">
          <canvas id="whiteboard" class="w-full h-full cursor-crosshair"></canvas>
          <div class="absolute bottom-2 right-3 pointer-events-none text-[10px] text-slate-500 bg-white/95 px-2 py-1 rounded border border-slate-300 shadow-sm font-medium">
            Gambarkan diagram vektor gaya/lintasan dan tulis langkah perhitungannya di sini
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between">
          <span class="text-[11px] text-emerald-700 font-bold flex items-center">
            <span class="w-2 h-2 rounded-full bg-emerald-600 mr-1.5 animate-pulse"></span> Auto-save tersimpan
          </span>
          <button onclick="finishExamPrompt()" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-xs sm:text-sm font-bold shadow-md transition text-white">
            Kirim Lembar Jawaban Ujian ➔
          </button>
        </div>
      </div>
    </section>

    <!-- STEP 3: HALAMAN SELESAI -->
    <section id="step-result" class="hidden max-w-lg mx-auto w-full bg-slate-100 p-7 sm:p-10 rounded-3xl border-2 border-slate-300 shadow-xl text-center my-auto">
      <div class="w-16 h-16 bg-emerald-100 text-emerald-700 rounded-2xl border border-emerald-300 mx-auto flex items-center justify-center text-3xl mb-4">
        ✓
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-slate-900">Selamat, Anda Telah Mengerjakan!</h2>
      <p class="text-xs sm:text-sm text-slate-700 mt-2 leading-relaxed font-medium">
        Seluruh lembar pengerjaan dan coretan sketsa rumus Anda telah berhasil terekam ke database guru mata pelajaran. Berdoalah supaya hasil nilainya maksimal!
      </p>

      <div class="my-6 p-4 rounded-2xl bg-white border border-slate-300 text-left text-xs space-y-2 text-slate-800 shadow-sm">
        <div><strong class="text-slate-500">Nama Lengkap:</strong> <span id="res-name" class="font-bold text-slate-900"></span></div>
        <div><strong class="text-slate-500">Kelas / Absen:</strong> <span id="res-class" class="font-bold text-slate-900"></span></div>
        <div><strong class="text-slate-500">Paket Soal:</strong> <span id="res-packet" class="font-bold text-indigo-700"></span></div>
        <div><strong class="text-slate-500">Status Pengerjaan:</strong> <span id="res-answered" class="font-bold text-emerald-700"></span></div>
        <div><strong class="text-slate-500">Total Pelanggaran Tab:</strong> <span id="res-cheat" class="font-bold text-rose-600"></span></div>
        <div><strong class="text-slate-500">Waktu Pengiriman:</strong> <span id="res-time" class="font-bold text-slate-900"></span></div>
      </div>

      <div class="space-y-3">
        <button onclick="downloadPDFBackup()" class="w-full py-3 px-4 bg-slate-800 hover:bg-slate-900 font-bold text-xs rounded-xl text-white shadow transition flex items-center justify-center space-x-2">
          <span>📄 Unduh Dokumen PDF Jawaban (Arsip Cadangan)</span>
        </button>
      </div>
    </section>

    <!-- STEP 4: BLOKIR AKSES & MENU BUKA KUNCI GURU -->
    <section id="step-blocked" class="hidden max-w-md mx-auto w-full bg-slate-100 p-8 rounded-3xl border-2 border-rose-300 shadow-xl text-center my-auto">
      <div class="w-16 h-16 bg-rose-100 text-rose-700 rounded-2xl border border-rose-300 mx-auto flex items-center justify-center text-3xl mb-4">
        🔒
      </div>
      <h2 class="text-xl font-black text-slate-900">Akses Ujian Ditutup</h2>
      <p class="text-xs text-slate-600 mt-2 leading-relaxed">
        Siswa dengan identitas ini tercatat telah menyelesaikan dan mengirimkan ujian ke sistem.
      </p>
      <div class="my-4 p-3 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700" id="block-student-info"></div>

      <!-- OPSI BUKA KUNCI GURU -->
      <div class="mt-4 pt-4 border-t border-slate-300">
        <p class="text-[11px] text-slate-500 mb-2">Ingin membuka sesi ujian baru? Masukkan PIN Guru Pengampu:</p>
        <div class="flex gap-2">
          <input type="password" id="teacher-pin-input" placeholder="PIN Guru" class="w-2/3 px-3 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-900 text-center">
          <button onclick="unlockStudentSession()" class="w-1/3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition">Buka Kunci</button>
        </div>
      </div>
    </section>

  </main>

  <!-- MODAL KALKULATOR SAINS TERINTEGRASI -->
  <div id="calc-modal" class="hidden fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 w-[340px] sm:w-[380px] bg-slate-900 border-2 border-slate-700 rounded-2xl shadow-2xl overflow-hidden">
    <div class="bg-slate-800 px-4 py-2 flex items-center justify-between border-b border-slate-700">
      <div class="flex items-center space-x-2">
        <span class="text-amber-400">🧮</span>
        <span class="text-xs font-bold text-white tracking-wide">Kalkulator Sains Fisika</span>
      </div>
      <button onclick="toggleCalculator()" class="text-slate-400 hover:text-white font-black text-sm px-2">✕</button>
    </div>
    
    <!-- Layar Display -->
    <div class="p-3 bg-slate-950">
      <div id="calc-history" class="text-right text-[11px] text-slate-400 min-h-[16px] overflow-x-auto font-mono"></div>
      <input type="text" id="calc-display" readonly value="0" class="w-full bg-transparent text-right text-xl font-bold font-mono text-cyan-300 focus:outline-none select-all">
    </div>

    <!-- Tombol Keypad Lengkap -->
    <div class="p-2.5 grid grid-cols-5 gap-1.5 bg-slate-900 text-[11px]">
      <button onclick="calcInput('rad/deg')" id="calc-angle-btn" class="bg-slate-700 hover:bg-slate-600 text-amber-300 font-bold py-2 rounded-lg text-xs">DEG</button>
      <button onclick="calcFunc('sin')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">sin</button>
      <button onclick="calcFunc('cos')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">cos</button>
      <button onclick="calcFunc('tan')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">tan</button>
      <button onclick="calcClear()" class="bg-rose-700 hover:bg-rose-600 text-white font-bold py-2 rounded-lg text-xs">AC</button>

      <button onclick="calcFunc('ln')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">ln</button>
      <button onclick="calcFunc('log')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">log</button>
      <button onclick="calcFunc('sqrt')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">√</button>
      <button onclick="calcOp('^')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">xʸ</button>
      <button onclick="calcBackspace()" class="bg-slate-700 hover:bg-slate-600 text-amber-300 font-bold py-2 rounded-lg text-xs">DEL</button>

      <button onclick="calcInput('(')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold py-2 rounded-lg text-xs">(</button>
      <button onclick="calcInput(')')" class="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold py-2 rounded-lg text-xs">)</button>
      <button onclick="calcFunc('inv')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">1/x</button>
      <button onclick="calcFunc('sqr')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">x²</button>
      <button onclick="calcOp('/')" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-black py-2 rounded-lg text-sm">÷</button>

      <button onclick="calcConst('pi')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">π</button>
      <button onclick="calcInput('7')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">7</button>
      <button onclick="calcInput('8')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">8</button>
      <button onclick="calcInput('9')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">9</button>
      <button onclick="calcOp('*')" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-black py-2 rounded-lg text-sm">×</button>

      <button onclick="calcConst('e')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">e</button>
      <button onclick="calcInput('4')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">4</button>
      <button onclick="calcInput('5')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">5</button>
      <button onclick="calcInput('6')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">6</button>
      <button onclick="calcOp('-')" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-black py-2 rounded-lg text-sm">−</button>

      <button onclick="calcFunc('10pow')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">10ˣ</button>
      <button onclick="calcInput('1')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">1</button>
      <button onclick="calcInput('2')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">2</button>
      <button onclick="calcInput('3')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">3</button>
      <button onclick="calcOp('+')" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-black py-2 rounded-lg text-sm">+</button>

      <button onclick="calcFunc('exp')" class="bg-indigo-950 hover:bg-indigo-900 text-indigo-300 font-bold py-2 rounded-lg text-xs border border-indigo-800">EXP</button>
      <button onclick="calcInput('0')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">0</button>
      <button onclick="calcInput('.')" class="bg-slate-800 hover:bg-slate-700 text-white font-bold py-2 rounded-lg text-sm">.</button>
      <button onclick="calcFunc('pm')" class="bg-slate-700 hover:bg-slate-600 text-slate-200 font-bold py-2 rounded-lg text-xs">±</button>
      <button onclick="calcEquals()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black py-2 rounded-lg text-sm shadow">=</button>
    </div>
  </div>

  <!-- SCRIPT ENGINE -->
  <script>
    const VALID_TOKEN = "VEKTOR11";
    const TEACHER_PIN = "GURU18";

    // 5 PAKET SOAL HOTS KELAS 11 (TANPA i, j, k & MENGGUNAKAN SUDUT REALISTIS)
    const questionPackets = {
      "Paket A": [
        { id: 1, topic: "Penguraian Komponen Gaya", text: "Sebuah balok ditarik di atas lantai mendatar oleh tali dengan gaya tegangan F = 250 N yang membentuk sudut elevasi 28° terhadap lantai. Uraikan vektor gaya tersebut dan hitunglah besar gaya yang efektif menarik balok maju secara mendatar (Fx) serta gaya yang mengangkat balok ke atas (Fy)!" },
        { id: 2, topic: "Vektor Kecepatan Aliran Sungai", text: "Sebuah perahu bermotor melintasi sungai selebar 120 meter dengan kecepatan mesin 8 m/s diarahkan tegak lurus ke seberang sungai (arah Utara). Arus sungai mengalir ke arah Timur dengan kecepatan tetap 6 m/s. Gambarkan sketsa lintasannya, hitung besar resultan kecepatan perahu (v_total), dan hitung jarak pergeseran perahu ke arah hilir saat tiba di seberang!" },
        { id: 3, topic: "Resultan Gaya Konstruksi (Aturan Kosinus)", text: "Dua kabel baja menopang sebuah beban pada jembatan gantung. Kabel pertama menarik dengan gaya F₁ = 400 N dan kabel kedua menarik dengan gaya F₂ = 300 N. Jika kedua kabel membentuk sudut apit 74°, hitunglah besar resultan gaya tarik total (R) yang bekerja pada titik sambungan jembatan tersebut!" },
        { id: 4, topic: "Analisis Resultan Tiga Gaya (Metode Komponen)", text: "Tiga gaya sebidang bekerja pada sebuah titik partikel: F₁ = 50 N ke arah Timur (0°), F₂ = 60 N membentuk sudut 40° ke arah Utara dari Timur, dan F₃ = 30 N tepat ke arah Utara (90°). Hitunglah jumlah komponen gaya sumbu-x (ΣFx), jumlah komponen sumbu-y (ΣFy), serta tentukan besar resultan gaya totalnya!" },
        { id: 5, topic: "Perkalian Skalar & Vektor Konseptual", text: "Sebuah peti ditarik dengan gaya tetap F = 180 N sejauh 15 meter pada lintasan mendatar, di mana arah gaya membentuk sudut 35° terhadap arah perpindahannya. Hitunglah besar usaha mekanik (W = F · s · cos θ) yang bekerja pada peti, serta jelaskan mengapa gaya yang tegak lurus perpindahan tidak menghasilkan usaha!" }
